generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario     Int       @id @default(autoincrement())
  nombre         String
  apellido       String
  dni            String    @unique
  sexo           Sexo
  email          String?   @unique
  telefono       String    @default("")
  direccion      String?
  fecha_creacion DateTime  @default(now())
  password       String
  deletedAt      DateTime?

  empleado Empleado?
  paciente Paciente?
  roles    UsuarioRol[]
}

model Rol {
  id_rol    Int          @id @default(autoincrement())
  nombre    TipoRol      @unique
  deletedAt DateTime?
  usuarios  UsuarioRol[]
}

model UsuarioRol {
  id               Int       @id @default(autoincrement())
  id_usuario       Int
  id_rol           Int
  fecha_asignacion DateTime  @default(now())
  deletedAt        DateTime?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
  rol     Rol     @relation(fields: [id_rol], references: [id_rol])

  @@unique([id_usuario, id_rol])
}

model Paciente {
  id_paciente            Int               @id @default(autoincrement())
  id_usuario             Int               @unique
  fecha_nacimiento       DateTime
  lugar_fecha_nacimiento String?
  direccion              String?
  procedencia            String?
  ocupacion              String?
  viajes                 String?
  telefono               String?
  emergencia             String?
  edad                   String?
  sexo                   Sexo?
  estado_civil           String?
  grado_instruccion      String?
  religion               String?
  citas                  Cita[]
  tickets                Ticket[]
  historiaClinica        Historia_Clinica?
  fecha_creacion         DateTime          @default(now())
  deletedAt              DateTime?

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])
}

model Empleado {
  id_empleado     Int       @id @default(autoincrement())
  id_usuario      Int       @unique
  id_especialidad Int?
  citas           Cita[]
  fecha_creacion  DateTime  @default(now())
  deletedAt       DateTime?

  usuario              Usuario          @relation(fields: [id_usuario], references: [id_usuario])
  especialidad         Especialidad?    @relation(fields: [id_especialidad], references: [id_especialidad])
  asignacionesHistoria DoctorAsignado[]

  @@index([id_especialidad])
}

model Servicio {
  id_servicio     Int            @id @default(autoincrement())
  nombre_servicio String
  descripcion     String?
  tarifa          Float
  citas           ServicioCita[]
  deletedAt       DateTime?
}

model ServicioCita {
  id_cita     Int
  id_servicio Int
  cantidad    Int @default(1)

  cita     Cita     @relation(fields: [id_cita], references: [id_cita])
  servicio Servicio @relation(fields: [id_servicio], references: [id_servicio])

  @@id([id_cita, id_servicio])
}

model Cita {
  id_cita           Int            @id @default(autoincrement())
  id_paciente       Int
  id_empleado       Int
  id_especialidad   Int?
  fecha_cita        DateTime
  hora_cita_inicial DateTime?
  hora_cita_final   DateTime?
  monto_pagado      Float          @default(0)
  deuda_restante    Float          @default(0)
  observaciones     String?
  estado            EstadoCita
  servicios         ServicioCita[]
  ticketCitas       TicketCita[]
  deletedAt         DateTime?

  paciente     Paciente      @relation(fields: [id_paciente], references: [id_paciente])
  empleado     Empleado      @relation(fields: [id_empleado], references: [id_empleado])
  especialidad Especialidad? @relation(fields: [id_especialidad], references: [id_especialidad])
}

model Especialidad {
  id_especialidad Int        @id @default(autoincrement())
  nombre          String     @unique
  citas           Cita[]
  empleados       Empleado[]
  deletedAt       DateTime?
}

model Ticket {
  id_ticket        Int       @id @default(autoincrement())
  id_paciente      Int
  fecha_emision    DateTime
  tipo_comprobante String
  medio_pago       String
  monto_total      Float
  monto_pagado     Float     @default(0)
  deuda_restante   Float     @default(0)
  deletedAt        DateTime?

  paciente    Paciente     @relation(fields: [id_paciente], references: [id_paciente])
  pagos       Pago[]
  ticketCitas TicketCita[]
}

model TicketCita {
  id_ticket Int
  id_cita   Int

  ticket Ticket @relation(fields: [id_ticket], references: [id_ticket])
  cita   Cita   @relation(fields: [id_cita], references: [id_cita])

  @@id([id_ticket, id_cita])
}

model Pago {
  id_pago        Int        @id @default(autoincrement())
  id_ticket      Int
  monto          Float
  fecha_pago     DateTime
  medio_pago     String
  fecha_creacion DateTime
  estado_pago    EstadoPago @default(PENDIENTE)
  deletedAt      DateTime?

  ticket Ticket @relation(fields: [id_ticket], references: [id_ticket])
}

model Historia_Clinica {
  id_historia           Int       @id @default(autoincrement())
  id_paciente           Int       @unique
  fecha_creacion        DateTime  @default(now())
  fecha_ultima_consulta DateTime?
  estado_tratamiento    String?
  fecha_alta            DateTime?

  // Campos clínicos
  hc                      String?
  fecha                   String?
  hora                    String?
  motivo_consulta         String?
  enfermedad_actual       String?
  tiempo_enfermedad       String?
  signos_sintomas         String?
  relato_cronologico      String?
  funciones_biologicas    String?
  antecedentes_familiares String?
  antecedentes_personales String?
  signos_pa               String?
  pulso                   String?
  temp                    String?
  fc                      String?
  f_resp                  String?
  examen_ocl              String?
  cie10_presuntivo        String?
  cie10_definitivo        String?
  plan_tratamiento        String?
  pronostico              String?
  recomendaciones         String?
  control_evolucion       String?
  alta_paciente           String?
  profesional_nombre      String?
  nombre_apoderado        String?
  dni_apoderado           String?
  cel_apoderado           String?
  correo_apoderado        String?

  // Antecedentes generales (booleanos y texto)
  antecedente_ram                   Boolean?
  antecedente_lidocaina             Boolean?
  antecedente_tabaco                Boolean?
  antecedente_alcohol               Boolean?
  antecedente_otros_generales       String?
  sed                               String?
  apetito                           String?
  deposicion                        String?
  miccion                           String?
  antecedente_ar                    Boolean?
  antecedente_les                   Boolean?
  antecedente_vih                   Boolean?
  antecedente_otros_inmunologicos   String?
  antecedente_hta                   Boolean?
  antecedente_dm                    Boolean?
  antecedente_iam                   Boolean?
  antecedente_anemia                Boolean?
  antecedente_asma                  Boolean?
  antecedente_tbc                   Boolean?
  antecedente_otros_patologicos     String?
  antecedente_familiar_hta          Boolean?
  antecedente_familiar_dm           Boolean?
  antecedente_familiar_iam          Boolean?
  antecedente_familiar_anemia       Boolean?
  antecedente_familiar_asma         Boolean?
  antecedente_familiar_tbc          Boolean?
  antecedente_otros_familiares      String?
  antecedente_dengue                Boolean?
  antecedente_fiebre_amarilla       Boolean?
  antecedente_its                   Boolean?
  antecedente_otros_epidemiologicos String?
  antecedente_stress                Boolean?
  antecedente_trauma_acustico       Boolean?
  antecedente_mercurialismo         Boolean?
  antecedente_otros_ocupacionales   String?
  antecedente_farmacologicos        String?
  especificacion_antecedentes       String?
  examen_extraoral                  String?
  examen_intraoral                  String?

  observaciones String?
  deletedAt     DateTime?

  paciente     Paciente         @relation(fields: [id_paciente], references: [id_paciente])
  asignaciones DoctorAsignado[]
}

model DoctorAsignado {
  id_historia      Int
  id_empleado      Int
  fecha_asignacion DateTime  @default(now())
  fecha_retiro     DateTime?

  historia Historia_Clinica @relation(fields: [id_historia], references: [id_historia])
  empleado Empleado         @relation(fields: [id_empleado], references: [id_empleado])

  @@id([id_historia, id_empleado, fecha_asignacion])
}

model Empresa {
  id_empresa          Int       @id @default(autoincrement())
  ruc                 String    @unique
  razon_social        String
  nombre_comercial    String?
  domicilio_fiscal    String?
  ubigeo              String?
  actividad_economica String?
  tipo_contribuyente  String?
  clave_sol           String?
  telefono            String?
  email               String?   @unique
  fecha_creacion      DateTime  @default(now())
  deletedAt           DateTime?
}

enum EstadoPago {
  PENDIENTE
  COMPLETADO
  FRACCIONADO
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoCita {
  AGENDADO
  COMPLETADO
  EN_PROCESO
  FINALIZADO
  CANCELADO
  PAGADA
}

enum TipoRol {
  ADMIN
  ODONTOLOGO
  PACIENTE
  RECEPCIONISTA
}
